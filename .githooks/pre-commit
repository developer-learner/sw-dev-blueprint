#!/usr/bin/env bash
# pre-commit — the interactive-path backstop (D-30).
#
# The orchestrator runs phase-gate.sh itself after every phase; this hook
# covers the OTHER entry point: a human (or a hand-driven agent session)
# committing directly. It enforces whatever phase the pipeline says is
# active, and always verifies the control-plane manifest and the frozen
# spec (both fail-closed).
#
# Enabled by: git config core.hooksPath .githooks   (bootstrap.sh does this)
#
# Self-resolving (D-168): gates always execute this hook's OWN tree, so a run
# executing from a D-168 plane snapshot gates its commits through the
# snapshot's copies — while an interactive commit reached via a child's
# symlinked .githooks resolves to the blueprint those symlinks serve. Either
# way the gate code and the manifest expectations it enforces come from one
# coherent tree, never mixed.
set -e
cd "$(git rev-parse --show-toplevel)"
# Self-resolving without readlink -f (unavailable on stock macOS < 13):
# walk the symlink chain manually, POSIX-only.
HOOK_TARGET="$0"
while [ -L "$HOOK_TARGET" ]; do
  _link="$(readlink "$HOOK_TARGET")"
  case $_link in
    /*) HOOK_TARGET="$_link" ;;
    *) HOOK_TARGET="$(dirname "$HOOK_TARGET")/$_link" ;;
  esac
done
HOOK_TREE="$(cd "$(dirname "$HOOK_TARGET")/.." && pwd -P)"

bash "$HOOK_TREE/scripts/doc-consistency.sh" || true

bash "$HOOK_TREE/scripts/manifest-drift-guard.sh" || true

phase=$(cat .pipeline-state/phase 2>/dev/null || true)
target=$(cat .pipeline-state/task_target 2>/dev/null || true)

case "$phase" in
  task)
    [ -n "$target" ] || { echo "pre-commit: task phase active but no task_target recorded"; exit 1; }
    exec bash "$HOOK_TREE/scripts/phase-gate.sh" task HEAD "$target"
    ;;
  em)
    exec bash "$HOOK_TREE/scripts/phase-gate.sh" em HEAD
    ;;
  *)
    # No active phase (or a stale build/test/architect from before the
    # 2026-07-22 retirement): integrity checks only.
    exec bash "$HOOK_TREE/scripts/phase-gate.sh" manifest HEAD
    ;;
esac
