#!/usr/bin/env bash
# pre-push — the publication gate (A2; D-168 follow-up).
#
# D-168 shipped a "release is good" claim while the full control-plane
# selftest suite was RED. CI (.github/workflows/ci.yml) runs that same suite,
# but only AFTER a push and only once a remote exists (the 2026-07-14
# meta-rule: "a gate that lives only in CI does not exist until a remote
# does") — too late to stop the publication itself. This hook makes
# publication fail-closed: a push that advances the release branch (default
# refs/heads/main) runs the exact CI suite command FIRST and refuses the push
# on any failure, or if the suite cannot run at all.
#
# Enabled by: git config core.hooksPath .githooks   (bootstrap.sh does this).
# Scope: only pushes that update the protected ref are gated; feature-branch
# and non-release pushes pass through untouched, so day-to-day work is
# unaffected. A deliberate operator override is `git push --no-verify` — never
# the pipeline's path, and self-documenting in the reflog/CI when used.
#
# Publication always runs from a real checkout, so unlike the pre-commit gate
# this hook needs no D-168 plane-snapshot self-resolution: it verifies the
# working tree it is pushing from, which is exactly the tree being published.
#
# Overridable for TESTS ONLY (see scripts/selftest/selftest_release_gate.py):
#   SWBP_RELEASE_PROTECTED_REF  (default refs/heads/main)
#   SWBP_RELEASE_SUITE_CMD      (default: the CI suite command below)
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1

PROTECTED_REF="${SWBP_RELEASE_PROTECTED_REF:-refs/heads/main}"
SUITE_CMD="${SWBP_RELEASE_SUITE_CMD:-pytest scripts/selftest/selftest_*.py -q}"
ZERO="0000000000000000000000000000000000000000"

# git feeds one line per pushed ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
gating=0
while read -r local_ref local_sha remote_ref remote_sha; do
  remote_ref="${remote_ref:-}"
  local_sha="${local_sha:-}"
  [ -n "$remote_ref" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue    # branch deletion: nothing to verify
  [ "$remote_ref" = "$PROTECTED_REF" ] && gating=1
done

[ "$gating" -eq 0 ] && exit 0

echo "release-gate: push updates $PROTECTED_REF — verifying the full control-plane suite before publication..." >&2
if eval "$SUITE_CMD" >&2; then
  echo "release-gate: control-plane suite green — publication allowed." >&2
  exit 0
fi
echo "release-gate: REFUSED — the control-plane selftest suite is not green; a release claim cannot be published on a red suite (D-168). Fix the suite, or override deliberately with 'git push --no-verify'." >&2
exit 1
