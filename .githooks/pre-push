#!/usr/bin/env bash
# pre-push — the publication gate (A2; D-168 follow-up).
#
# D-168 shipped a "release is good" claim while the full control-plane
# selftest suite was RED. CI (.github/workflows/ci.yml) runs that same suite,
# but only AFTER a push and only once a remote exists (the 2026-07-14
# meta-rule: "a gate that lives only in CI does not exist until a remote
# does") — too late to stop the publication itself. This hook makes
# publication fail-closed: a push that advances the release branch (default
# refs/heads/main) runs the exact CI suite command FIRST and refuses the push
# on any failure, or if the suite cannot run at all.
#
# It verifies the COMMIT BEING PUSHED, not the working tree. The tree can be
# green (clean checkout, or unstaged edits) while a different, red SHA is what
# actually lands on the remote — e.g. `git push origin other:main`. So the
# hook materializes the pushed SHA into a throwaway detached worktree and runs
# the suite THERE; the working tree's state never decides a publication.
#
# Enabled by: git config core.hooksPath .githooks   (bootstrap.sh does this).
# Scope: only pushes that update the protected ref are gated; feature-branch
# and non-release pushes pass through untouched. Deliberate operator override
# is `git push --no-verify` — never the pipeline's path, self-documenting when
# used.
#
# Overridable for TESTS ONLY (see scripts/selftest/selftest_release_gate.py):
#   SWBP_RELEASE_PROTECTED_REF  (default refs/heads/main)
#   SWBP_RELEASE_SUITE_CMD      (default: the CI suite command below)
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
PUSH_REPO="$(pwd -P)"

# When a child uses the supported linked-template mode, this hook itself
# resolves into the Blueprint checkout. Remember that Git repository so the
# exact pinned plane can be materialized beside the throwaway child worktree.
# Relative child links then resolve exactly as they do in the live checkout.
HOOK_FILE="$(python3 - "$0" <<'PY'
import os
import sys
print(os.path.realpath(sys.argv[1]))
PY
)"
HOOK_REPO="$(git -C "$(dirname "$HOOK_FILE")" rev-parse --show-toplevel 2>/dev/null || true)"

PROTECTED_REF="${SWBP_RELEASE_PROTECTED_REF:-refs/heads/main}"
SUITE_CMD="${SWBP_RELEASE_SUITE_CMD:-pytest scripts/selftest/selftest_*.py -q}"
ZERO="0000000000000000000000000000000000000000"

# git feeds one line per pushed ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
gating=0
PUSH_SHA=""
while read -r local_ref local_sha remote_ref remote_sha; do
  remote_ref="${remote_ref:-}"
  local_sha="${local_sha:-}"
  [ -n "$remote_ref" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue    # branch deletion: nothing to verify
  if [ "$remote_ref" = "$PROTECTED_REF" ]; then
    gating=1
    PUSH_SHA="$local_sha"                    # the exact commit being published
  fi
done

[ "$gating" -eq 0 ] && exit 0

if [ -z "$PUSH_SHA" ]; then
  echo "release-gate: REFUSED — a push to $PROTECTED_REF carried no commit SHA to verify." >&2
  exit 1
fi

# Verify the pushed COMMIT in isolation from the working tree.
PARENT="$(mktemp -d "${TMPDIR:-/tmp}/release-gate.XXXXXX")" || {
  echo "release-gate: REFUSED — could not create a verification workspace." >&2
  exit 1
}
TMPTREE="$PARENT/tree"
LINKED_PLANE=""
cleanup() {
  if [ -n "$LINKED_PLANE" ] && [ -n "$HOOK_REPO" ]; then
    git -C "$HOOK_REPO" worktree remove --force "$LINKED_PLANE" >/dev/null 2>&1
  fi
  git -C "$PUSH_REPO" worktree remove --force "$TMPTREE" >/dev/null 2>&1
  rm -rf "$PARENT"
}
trap cleanup EXIT

echo "release-gate: push updates $PROTECTED_REF at $PUSH_SHA — verifying that exact commit before publication..." >&2
if ! git -C "$PUSH_REPO" worktree add --detach -q "$TMPTREE" "$PUSH_SHA" >/dev/null 2>&1; then
  echo "release-gate: REFUSED — could not check out $PUSH_SHA for verification." >&2
  exit 1
fi

# A linked child deliberately commits relative symlinks rather than copied
# plane files. The isolated child checkout therefore needs a sibling checkout
# of the exact pinned Blueprint commit before its suite can run. Refuse unsafe
# or malformed link metadata instead of silently testing some other plane.
if [ -f "$TMPTREE/.template-link" ]; then
  link_mode="$(sed -n 's/^mode=//p' "$TMPTREE/.template-link")"
  link_source="$(sed -n 's/^source=//p' "$TMPTREE/.template-link")"
  link_pin="$(sed -n 's/^ref=//p' "$TMPTREE/.template-version")"
  if [ "$link_mode" != "linked" ] || [ -z "$link_source" ] || [ -z "$link_pin" ] || [ -z "$HOOK_REPO" ]; then
    echo "release-gate: REFUSED — linked-template metadata or Blueprint source repository is unavailable." >&2
    exit 1
  fi
  LINKED_PLANE="$(python3 - "$PARENT" "$TMPTREE" "$link_source" <<'PY'
import os
import sys

parent = os.path.abspath(sys.argv[1])
tree = os.path.abspath(sys.argv[2])
source = sys.argv[3]
candidate = os.path.abspath(os.path.join(tree, source))
if os.path.commonpath((parent, candidate)) != parent or candidate == tree:
    raise SystemExit(1)
print(candidate)
PY
)" || {
    echo "release-gate: REFUSED — linked-template source must resolve inside the isolated verification workspace." >&2
    exit 1
  }
  if ! git -C "$HOOK_REPO" worktree add --detach -q "$LINKED_PLANE" "$link_pin" >/dev/null 2>&1; then
    echo "release-gate: REFUSED — could not materialize pinned Blueprint commit $link_pin for linked-child verification." >&2
    exit 1
  fi
fi

if ( cd "$TMPTREE" && eval "$SUITE_CMD" ) >&2; then
  echo "release-gate: control-plane suite green at $PUSH_SHA — publication allowed." >&2
  exit 0
fi
echo "release-gate: REFUSED — the control-plane selftest suite is not green at the commit being pushed ($PUSH_SHA); a release claim cannot be published on a red suite (D-168). Fix the suite, or override deliberately with 'git push --no-verify'." >&2
exit 1
