{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "tests/**": "deny",
      "scripts/**": "deny",
      ".githooks/**": "deny",
      ".opencode/**": "deny",
      "opencode.json": "deny",
      ".gate-paths": "deny",
      ".template-version": "deny",
      "src/**": "deny",
      "conftest.py": "deny",
      "pytest.ini": "deny",
      "pyproject.toml": "deny",
      "setup.cfg": "deny",
      "tox.ini": "deny"
    },
    "bash": {
      "scripts/refreeze.sh *": "ask",
      "scripts/orchestrate.sh*": "allow",
      "SANDBOX=1 scripts/orchestrate.sh*": "allow",
      "scripts/new-project.sh *": "allow",
      "scripts/bootstrap.sh*": "allow",
      "scripts/tpm-pack.sh*": "allow",
      "scripts/tpm-unpack.sh*": "allow",
      "scripts/tpm-agent.sh*": "allow",
      "scripts/sandbox-run.sh *": "allow",
      "scripts/check-drift.sh*": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "cat *": "allow",
      "ls *": "allow",
      "*": "ask"
    }
  },
  "agent": {
    "build": {
      "tools": {
        "task": false
      }
    },
    "em": {
      "mode": "primary",
      "description": "Engineering manager: decomposes the frozen spec into tasks/plan.json and answers shell-initiated consults with tasks/diagnosis.json. Writes tasks/** only. Never spawns agents \u2014 the shell invokes the coder from the plan (D-26/D-43).",
      "prompt": "{file:./.opencode/prompts/em.md}",
      "tools": {
        "task": false
      },
      "permission": {
        "edit": {
          "src/**": "deny",
          "tests/**": "deny",
          "docs/**": "deny",
          "scripts/**": "deny",
          "tasks/**": "allow",
          "**": "deny"
        }
      }
    },
    "coder": {
      "mode": "primary",
      "description": "Implements exactly the one source file its task brief names, then runs the brief's self-verify step. Never touches tests, tasks, docs, or scripts, and never spawns agents (D-43).",
      "prompt": "{file:./.opencode/prompts/coder.md}",
      "tools": {
        "task": false
      },
      "permission": {
        "edit": {
          "tests/**": "deny",
          "tasks/**": "deny",
          "docs/**": "deny",
          "scripts/**": "deny",
          ".githooks/**": "deny",
          ".opencode/**": "deny",
          "opencode.json": "deny",
          ".gate-paths": "deny",
          ".template-version": "deny",
          "conftest.py": "deny",
          "pytest.ini": "deny",
          "pyproject.toml": "deny",
          "setup.cfg": "deny",
          "tox.ini": "deny",
          "**": "allow"
        }
      }
    }
  }
}
