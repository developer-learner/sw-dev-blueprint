{
  "$schema": "https://opencode.ai/config.json",
  "_comment": "D-53: this file configures OpenCode ONLY if the CEO chooses it as their conductor chat interface — it is no longer part of the pipeline itself. em/coder are called directly over HTTP by orchestrate.sh (scripts/llm-call.sh), so there is nothing left here for them to configure; any conductor (this, Claude Code, a plain shell) works identically since none of them sit in the trust-critical path.",
  "permission": {
    "edit": {
      "tests/**": "deny",
      "scripts/**": "deny",
      ".githooks/**": "deny",
      ".opencode/**": "deny",
      "opencode.json": "deny",
      ".gate-paths": "deny",
      ".template-version": "deny",
      "src/**": "deny",
      "conftest.py": "deny",
      "pytest.ini": "deny",
      "pyproject.toml": "deny",
      "setup.cfg": "deny",
      "tox.ini": "deny"
    },
    "bash": {
      "scripts/refreeze.sh *": "ask",
      "scripts/orchestrate.sh*": "allow",
      "SANDBOX=1 scripts/orchestrate.sh*": "allow",
      "scripts/new-project.sh *": "allow",
      "scripts/bootstrap.sh*": "allow",
      "scripts/tpm-pack.sh*": "allow",
      "scripts/tpm-unpack.sh*": "allow",
      "scripts/tpm-agent.sh*": "allow",
      "scripts/sandbox-run.sh *": "allow",
      "scripts/check-drift.sh*": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "cat *": "allow",
      "ls *": "allow",
      "*": "ask"
    }
  },
  "agent": {
    "build": {
      "tools": {
        "task": false
      }
    }
  }
}
