{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "tests/**": "deny",
      "scripts/**": "deny",
      ".githooks/**": "deny",
      ".opencode/**": "deny",
      "opencode.json": "deny",
      ".gate-paths": "deny",
      ".template-version": "deny",
      "src/**": "deny"
    },
    "bash": {
      "scripts/refreeze.sh *": "ask"
    }
  },
  "agent": {
    "em": {
      "mode": "subagent",
      "description": "Engineering manager: decomposes the frozen spec into tasks/plan.json and answers shell-initiated consults with tasks/diagnosis.json. Writes tasks/** only.",
      "prompt": "{file:./.opencode/prompts/em.md}",
      "permission": {
        "edit": {
          "src/**": "deny",
          "tests/**": "deny",
          "docs/**": "deny",
          "scripts/**": "deny",
          "tasks/**": "allow"
        }
      }
    },
    "coder": {
      "mode": "subagent",
      "description": "Implements exactly the one source file its task brief names, then runs the brief's self-verify step. Never touches tests, tasks, docs, or scripts.",
      "prompt": "{file:./.opencode/prompts/coder.md}",
      "permission": {
        "edit": {
          "tests/**": "deny",
          "tasks/**": "deny",
          "docs/**": "deny",
          "scripts/**": "deny",
          "**": "allow"
        }
      }
    }
  }
}
