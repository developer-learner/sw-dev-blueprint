#!/usr/bin/env bash
# swbp — run the builder against an app (D-186 stage B).
#
#   scripts/swbp <cmd> --app <path> [--ref <sha>] [-- <cmd args>...]
#
# The app carries no control plane. swbp resolves a builder ref (default: the
# app's pin — `.swbp` ref=, else a linked child's `.template-version` ref=),
# materializes that exact commit into the same content-addressed snapshot
# D-168 uses ($XDG_CACHE_HOME/swbp-plane/<sha>), and execs the snapshot's
# script with cwd = the app. Authority is the pinned ref, never this
# checkout's working tree.
#
# Builder-only: this file is not in .manifest-template and never reaches an
# app. Apps marked by a `.swbp` file are "builder-targeted": phase-gate skips
# the hosted-plane checks there (no plane to hash) while the frozen spec stays
# fully verified, and core.hooksPath (untracked .git/config) points at the
# snapshot's hooks.
set -euo pipefail

die() { echo "swbp: $*" >&2; exit 1; }

usage() {
  echo "usage: swbp <cmd> --app <path> [--ref <sha>] [-- <args>...]" >&2
  echo "  cmd: orchestrate refreeze tpm-pack tpm-unpack tpm-view tpm-agent em-bench status" >&2
  echo "       guard [--range A..B] [--enforce]   (D-186 app guard, report-first)" >&2
  echo "       commit -- <subject> [file...]      (a person's change, via the provenance broker)" >&2
  exit 2
}

self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case $link in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
BUILDER="$(cd "$(dirname "$self")/.." && pwd -P)"

[ $# -ge 1 ] || usage
CMD="$1"; shift
case "$CMD" in
  orchestrate|refreeze|tpm-pack|tpm-unpack|tpm-view|tpm-agent|em-bench|status|guard|commit) ;;
  -h|--help) usage ;;
  *) die "unknown command: $CMD" ;;
esac

APP="" REF=""
while [ $# -gt 0 ]; do
  case "$1" in
    --app) [ $# -ge 2 ] || usage; APP="$2"; shift 2 ;;
    --ref) [ $# -ge 2 ] || usage; REF="$2"; shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
[ -n "$APP" ] || usage
[ -d "$APP" ] || die "app not found: $APP"
APP="$(cd "$APP" && pwd -P)"
top="$(git -C "$APP" rev-parse --show-toplevel 2>/dev/null || true)"
[ "$top" = "$APP" ] || die "app must be the root of a git repository: $APP"
[ "$APP" != "$BUILDER" ] || die "the builder cannot target itself"

pin_of() {  # ref= from a pin file, or empty
  [ -f "$1" ] && sed -n 's/^ref=//p' "$1" | head -1 | tr -d '[:space:]' || true
}
if [ -z "$REF" ]; then
  REF="$(pin_of "$APP/.swbp")"
  [ -n "$REF" ] || REF="$(pin_of "$APP/.template-version")"
fi
[ -n "$REF" ] || die "no builder ref: pass --ref or pin one in $APP/.swbp (ref=<sha>)"
SHA="$(git -C "$BUILDER" rev-parse --verify --quiet "$REF^{commit}" || true)"
[ -n "$SHA" ] || die "builder ref $REF not present in $BUILDER — fetch it first"

# Materialize once, content-addressed — identical to D-168's layout, so an
# orchestrate re-exec and a swbp launch share the same snapshot.
# D-201: published by ONE rename of a complete, stamped stage dir; a published
# snapshot is never deleted or rewritten (another launcher may be running
# from it). Same rules as orchestrate.sh's _plane_publish.
ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/swbp-plane/$SHA"
if [ ! -f "$ROOT/.swbp-plane-stamped" ]; then
  stage="${ROOT}.tmp.$$"
  rm -rf "$stage"
  mkdir -p "$stage"
  git -C "$BUILDER" archive "$SHA" | tar -x -C "$stage"
  : > "$stage/.swbp-plane-stamped"
  python3 - "$stage" "$ROOT" "${SWBP_PLANE_PUBLISH_WAIT:-30}" <<'PYPUBLISH' \
    || die "could not publish the plane snapshot at $ROOT"
import os
import shutil
import sys
import time

stage, root, wait = sys.argv[1], sys.argv[2], float(sys.argv[3])
stamp = os.path.join(root, ".swbp-plane-stamped")


def rename() -> bool:
    try:
        os.rename(stage, root)
        return True
    except OSError:
        return False


if rename():
    sys.exit(0)
deadline = time.time() + wait
while not os.path.exists(stamp) and time.time() < deadline:
    time.sleep(0.2)
if not os.path.exists(stamp):
    aside = f"{root}.stale.{os.getpid()}"
    try:
        os.rename(root, aside)
    except OSError:
        pass
    if rename():
        shutil.rmtree(aside, ignore_errors=True)
        sys.exit(0)
    if not os.path.exists(stamp):
        sys.exit(f"cannot publish plane snapshot at {root}")
shutil.rmtree(stage, ignore_errors=True)
PYPUBLISH
fi
# A ref older than this launcher resolves helpers against the wrong root —
# its entry scripts would cd into the snapshot itself. Refuse, don't guess.
[ -f "$ROOT/scripts/swbp" ] \
  || die "builder ref $SHA predates swbp (D-186 stage B) — pin a newer ref"
case "$CMD" in
  guard)  SCRIPT="$ROOT/scripts/check-app-guard.py" ;;
  commit) SCRIPT="$ROOT/scripts/git-provenance.sh" ;;
  *)      SCRIPT="$ROOT/scripts/$CMD.sh" ;;
esac
[ -f "$SCRIPT" ] || die "$CMD not available at builder ref $SHA"

# D-168 rule, same wording: the plane may not change under an in-flight
# milestone. Recorded by orchestrate itself; checked here for every entry.
prev="$(cat "$APP/.pipeline-state/plane-sha" 2>/dev/null || true)"
if [ -n "$prev" ] && [ "$prev" != "$SHA" ] \
   && [ -n "$(ls -A "$APP/.pipeline-state/tasks" 2>/dev/null || true)" ]; then
  die "mid-milestone plane adoption forbidden (D-168): state recorded $prev, requested $SHA — finish the milestone on $prev, adopt afterwards"
fi

if [ -f "$APP/.swbp" ]; then
  # Builder-targeted app: its commits gate through the pinned snapshot's
  # hooks. Untracked config — nothing lands in the app's history.
  # D-201: core.hooksPath points at small shims inside the app's own git dir,
  # not into the cache. git silently runs NO hooks when hooksPath is missing,
  # so a purged cache used to leave every commit ungated; a shim survives the
  # purge and refuses until any swbp entry re-materializes the snapshot.
  hook_dir="$(git -C "$APP" rev-parse --absolute-git-dir)/swbp-hooks"
  mkdir -p "$hook_dir"
  for hook in "$ROOT"/.githooks/*; do
    [ -f "$hook" ] || continue
    name="$(basename "$hook")"
    cat > "$hook_dir/$name.tmp.$$" <<SHIM
#!/bin/sh
# swbp hook shim (D-201): forwards to the pinned plane snapshot. Written by
# scripts/swbp into .git, so a cache purge cannot remove it.
target='$hook'
if [ ! -x "\$target" ]; then
  echo "swbp: plane snapshot missing (\$target) — rerun any 'swbp <cmd> --app <this repo>' to restore it; refusing to run ungated" >&2
  exit 1
fi
exec "\$target" "\$@"
SHIM
    chmod +x "$hook_dir/$name.tmp.$$"
    mv "$hook_dir/$name.tmp.$$" "$hook_dir/$name"
  done
  [ -x "$ROOT/.githooks/pre-commit" ] && [ -x "$hook_dir/pre-commit" ] \
    || die "hooks missing in the plane snapshot $ROOT — refusing to continue ungated"
  # A linked worktree shares .git/config with its main checkout — writing
  # there would re-point the MAIN checkout's hooks too. Scope it per worktree.
  if [ "$(git -C "$APP" rev-parse --git-dir)" != "$(git -C "$APP" rev-parse --git-common-dir)" ]; then
    git -C "$APP" config extensions.worktreeConfig true
    git -C "$APP" config --worktree core.hooksPath "$hook_dir"
  else
    git -C "$APP" config core.hooksPath "$hook_dir"
  fi
fi
if [ "$CMD" = orchestrate ]; then
  # orchestrate's own guard records this, but it returns early under a
  # snapshot — record it here so the rule above has its evidence.
  mkdir -p "$APP/.pipeline-state"
  echo "$SHA" > "$APP/.pipeline-state/plane-sha"
fi

cd "$APP"
export SWBP_PLANE_SNAPSHOT="$ROOT" SWBP_PLANE_SHA="$SHA" SWBP_APP_ROOT="$APP" \
  GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath \
  GIT_CONFIG_VALUE_0="$ROOT/.githooks"
case "$CMD" in
  guard)
    exec python3 "$SCRIPT" "$@" ;;
  commit)
    [ $# -ge 1 ] || die "commit needs a subject: swbp commit --app <path> -- <subject> [file...]"
    # shellcheck disable=SC1090
    source "$SCRIPT"
    swbp_commit human "$@"
    exit $? ;;
  *)
    exec bash "$SCRIPT" "$@" ;;
esac
