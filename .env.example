# .env.example — copy to .env and fill in. NEVER commit .env.

# --- App ---
DEBUG=false
SECRET_KEY=change-me

# --- Database (default: SQLite; uncomment Postgres if needed) ---
DATABASE_URL=sqlite+aiosqlite:///./app.db
# Postgres alternative (also uncomment CI services block):
# DATABASE_URL=postgresql://localhost/myapp

# --- Model config (D-53) ---
# The role→model mapping lives in ~/.config/sw-dev-blueprint/models.env on
# the host and inside the dev VM, read by scripts/llm-call.sh. Nothing in
# this .env is read by the pipeline — the app vars above are for the child
# project's own application code.
