# .gate-paths — directory layout metadata for the pipeline.
# Change these if your project uses a non-standard directory structure
# (e.g. app/ + spec/).
#
# `build=` is read by scripts/orchestrate.sh and scripts/validate-plan.py
# for src-dir pathing (the build lane the coder writes into via the `task`
# phase gate). `test=` is retained for child compatibility; the pipeline
# reads tests/ directly.
#
# The `build_extra=` / `test_extra=` keys were used by the phase-gate.sh
# `build` and `test` phases retired 2026-07-22 — see D-25/D-37 amendments.
# Existing lines here are harmless; new keys serve no purpose.
build=src/
test=tests/
