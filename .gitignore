# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Env / secrets
.env
.env.test
.env.*.local

# Test artifacts
.cache/

# Pipeline runtime state (crash recovery for the orchestrator)
.pipeline-state/

# EM call archive (prompt+reply pairs for offline bench-testing, backlog item 6)
.em-archive/

# EM consult output — consumed and archived by the orchestrator, never committed
tasks/diagnosis.json

# TPM delta staging — applied by refreeze.sh, never committed as-is
scripts/.approved/incoming/

# OpenCode session data (keep prompt files tracked)
/.opencode/*
!/.opencode/prompts/

# Review working documents (session inputs at the repo root, not template content)
/REVIEW.md

# Generated outputs
repomix-output.md
repomix-output.*

# Editor backups
*.bak

# OS
.DS_Store
blueprint-dryrun*/

# TPM agent write lane — outbox is consumed by refreeze.sh, never committed
.tpm/

# Session lab-notebook — dated session-state handoffs and ad-hoc experiment
# scripts. Per-operator working notes; the durable record of what happened
# lives in DECISIONS.md (D-entries) and the correction log in CLAUDE.md.
# Reference doctrine that once lived under tasks/HANDOFF-* has been moved to
# docs/ (DEV-VM-SETUP.md, BROWSER-ORACLE-DESIGN.md); those stay tracked.
tasks/HANDOFF-*
tasks/em-ab-test.py
